# Copy to .env and fill in the REQUIRED values. Every setting: https://docs.shorthop.io/configuration

# REQUIRED — the database password (any long random string; the Postgres container uses it too).
#   openssl rand -hex 24
POSTGRES_PASSWORD=

# REQUIRED — signs sign-in sessions. Keep it stable: changing it signs everyone out.
#   openssl rand -hex 32
SECRET_KEY=

# REQUIRED — the first admin. Give them a password once the stack is up:
#   docker compose exec shorthop python -m app.cli admin you@example.com
BOOTSTRAP_ADMIN_EMAIL=

# The address people open the web UI at (used in links in emails and Slack).
PUBLIC_URL=http://localhost:8080

# The internet-facing address of port 8081, if phones should reach Shorthop outside your
# network (pairing links and calendar feeds use it). Leave empty until you set that up.
PUBLIC_API_URL=

# Paging phones through the Shorthop app: your installation key from https://account.shorthop.io
# (first 3 phones free). Without it Shorthop still pages by email, webhook and Slack.
RELAY_URL=https://relay.shorthop.io
RELAY_KEY=

# Email paging (any SMTP server). Can also be set later on the Settings page.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Host ports, if 8080 / 8081 are taken on this machine.
# SHORTHOP_PORT=8080
# SHORTHOP_PUBLIC_PORT=8081

# Which image tag to run: "0" follows every 0.x release; pin e.g. "0.1.0" to upgrade by hand.
SHORTHOP_VERSION=0
